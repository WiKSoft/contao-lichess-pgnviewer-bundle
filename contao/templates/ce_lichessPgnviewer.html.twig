<!-- indexer::stop -->
{#
    Zusätzliche Partiedaten, die der lichess-pgn-viewer selbst nicht
    anzeigt (er zeigt nur Spielernamen/Elo im eigenen Kopfbereich). "tag"
    ist der PGN-Tag-Name (siehe game.headers), "key" der daraus abgeleitete
    data-*-Attribut-/Übersetzungsschlüssel (MSC.lpv_info_<key>).
#}
{% set lpvInfoFields = [
    {'tag': 'White', 'key': 'white'},
    {'tag': 'Black', 'key': 'black'},
    {'tag': 'Result', 'key': 'result'},
    {'tag': 'Event', 'key': 'event'},
    {'tag': 'Round', 'key': 'round'},
    {'tag': 'Site', 'key': 'site'},
    {'tag': 'Date', 'key': 'date'},
    {'tag': 'ECO', 'key': 'eco'},
    {'tag': 'WhiteElo', 'key': 'whiteelo'},
    {'tag': 'BlackElo', 'key': 'blackelo'},
    {'tag': 'Annotator', 'key': 'annotator'},
    {'tag': 'Source', 'key': 'source'},
] %}
<div class="{{ class }} block lpv-wrapper{% block wrapperExtraClass %}{% endblock %}" {{ cssID }}{% if style %} style="{{ style }}"{% endif %}>
    {% block headline %}
        {% if headline %}
            <{{ hl }}>{{ headline }}</{{ hl }}>
        {% endif %}
    {% endblock %}

    {% block roundNav %}
        {#
            Nur bei Quelle "Interne Datenbank" (lpv_source == 'd') mit
            aktiviertem Feld "lpv_dbChess_roundNav" gesetzt (siehe
            ContentLichessPgnviewer::applyRoundNavigation()). Das Dropdown
            oben (Block "gameSelect") enthält in diesem Fall bereits nur die
            Partien der unter "currentRound" angegebenen Runde.
        #}
        {% if roundNavEnabled %}
            <nav class="lpv-round-nav" aria-label="{{ 'MSC.lpv_round_label'|trans({}, 'contao_default') }}">
                <ul>
                    {% if prevRoundHref %}
                        <li class="lpv-round-nav__prev prev">
                            <a href="{{ prevRoundHref }}" rel="prev">
                                {{ 'MSC.lpv_round_prev'|trans({}, 'contao_default') }} ({{ prevRound }})
                            </a>
                        </li>
                    {% endif %}
                    <li class="lpv-round-nav__current current">{{ 'MSC.lpv_round_label'|trans({}, 'contao_default') }} {{ currentRound }}</li>
                    {% if nextRoundHref %}
                        <li class="lpv-round-nav__next next">
                            <a href="{{ nextRoundHref }}" rel="next">
                                {{ 'MSC.lpv_round_next'|trans({}, 'contao_default') }} ({{ nextRound }})
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    {% endblock %}

    {% block gameInfo %}
        {#
            Weitere Partiedaten (Veranstaltung, Ort, Runde, ECO, Elo,
            Kommentator, Quelle), die der lichess-pgn-viewer selbst nicht
            anzeigt (er zeigt nur Spielernamen/Elo im Kopf). Wird beim
            Wechsel der Partie im Dropdown per JavaScript aus den
            data-*-Attributen der ausgewählten <option> aktualisiert, siehe
            lichess-pgn-viewer-init.js.
        #}
        {% if hasGames and showGameInfo %}
            {% set h = games[0].headers %}
            <dl class="lpv-info" id="{{ elementId }}-info">
                {% for key in lpvInfoFields %}
                    {% if key.tag == 'Date' %}
                        {#
                            Datum im Systemformat (d.m.Y, siehe
                            system/config/localconfig.php) statt PGN-Rohformat
                            (JJJJ.MM.TT); unbekannte Teile ("?"/"??") werden
                            weggelassen, bekannte Teile bleiben zusammen (z. B.
                            "1905.08.??" -> "08.1905", "1905.??.??" -> "1905").
                        #}
                        {% set dp = h.Date is defined and h.Date ? h.Date|split('.')|map(p => p matches '/^[0-9]+$/' ? p : '') : ['', '', ''] %}
                        {% set v = dp[0] and dp[1] and dp[2] ? '%02d.%02d.%04d'|format(dp[2], dp[1], dp[0]) : (dp[0] and dp[1] ? '%02d.%04d'|format(dp[1], dp[0]) : dp[0]) %}
                    {% else %}
                        {% set v = h[key.tag] is defined and h[key.tag] and h[key.tag] != '?' and (key.tag != 'Result' or h[key.tag] != '*') ? h[key.tag] : '' %}
                    {% endif %}
                    <div class="lpv-info__row" data-lpv-info="{{ key.key }}"{% if not v %} hidden{% endif %}>
                        <dt>{{ ('MSC.lpv_info_' ~ key.key)|trans({}, 'contao_default') }}</dt>
                        <dd>{{ v }}</dd>
                    </div>
                {% endfor %}
            </dl>
        {% endif %}
    {% endblock %}

    {% block gameSelect %}
        {#
            Auswahlliste bei mehreren Partien in der PGN-Quelle.

            "games" enthält alle gefundenen Partien in der Reihenfolge der
            Quelle (Datei-/Textreihenfolge bzw. "ORDER BY date ASC" bei der
            dbChess-Datenbank). Jede Partie hat "pgn" (vollständiger
            Partie-PGN-Text) sowie "headers" (die geparsten PGN-Tag-Pairs,
            z. B. headers.White, headers.Black, headers.Date, headers.Event,
            headers.Round, headers.Result, headers.Eco - je nachdem, welche
            Tags in der Partie vorhanden sind).

            Anzeige UND Sortierung der Menüpunkte sind bewusst hier im
            Template gelöst, nicht im PHP-Code:
            - Beschriftung anpassen: siehe "label"-Berechnung weiter unten.
            - Reihenfolge umkehren: "games" z. B. durch "games|reverse" ersetzen.
            - Nach einem Header-Feld sortieren (falls die Twig-Version
              Arrow-Functions im sort-Filter unterstützt, ab Twig 3.11):
              games|sort((a, b) => (a.headers.White ?? '') <=> (b.headers.White ?? ''))
        #}
        {% if showGameSelect %}
            <div class="lpv-select">
                <label for="{{ elementId }}-select">{{ 'MSC.lpv_gameSelect_label'|trans({}, 'contao_default') }}</label>
                <select id="{{ elementId }}-select" class="lpv-select__input" data-lpv-select>
                    {% for game in games %}
                        {% set h = game.headers %}
                        {#
                            Datum im Systemformat statt PGN-Rohformat für die
                            Dropdown-Beschriftung - dieselbe Logik wie im
                            gameInfo-Block oben, siehe dort für Details.
                        #}
                        {% set dp = h.Date is defined and h.Date ? h.Date|split('.')|map(p => p matches '/^[0-9]+$/' ? p : '') : ['', '', ''] %}
                        {% set dv = dp[0] and dp[1] and dp[2] ? '%02d.%02d.%04d'|format(dp[2], dp[1], dp[0]) : (dp[0] and dp[1] ? '%02d.%04d'|format(dp[1], dp[0]) : dp[0]) %}
                        {#
                            Beschriftung: die Auswahlliste wird ausschließlich
                            für Partie-Varianten mit unterschiedlichen
                            Kommentatoren/Quellen genutzt (siehe
                            ContentLichessPgnviewer::collectSidVariants()) -
                            deshalb hier Kommentator und Quelle statt der
                            Spielpaarung, getrennt durch "/". Fehlt eine der
                            beiden Angaben, wird nur die andere gezeigt; fehlen
                            beide, erscheint der Platzhalter
                            "lpv_annotator_variant_none".
                        #}
                        {% set annotator = h.Annotator is defined and h.Annotator and h.Annotator != '?' ? h.Annotator : '' %}
                        {% set source = h.Source is defined and h.Source and h.Source != '?' ? h.Source : '' %}
                        {% set label %}
                            {%- if annotator and source -%}
                                {{ annotator }} / {{ source }}
                            {%- elseif annotator -%}
                                {{ annotator }}
                            {%- elseif source -%}
                                {{ source }}
                            {%- else -%}
                                {{ 'MSC.lpv_annotator_variant_none'|trans({}, 'contao_default') }}
                            {%- endif -%}
                        {% endset %}
                        <option
                            value="{{ loop.index0 }}"
                            data-pgn="{{ game.pgn|e('html_attr') }}"
                            {%- for key in lpvInfoFields %}
                                {% if key.tag == 'Date' %}
                                    {% set v = dv %}
                                {% else %}
                                    {% set v = h[key.tag] is defined and h[key.tag] and h[key.tag] != '?' and (key.tag != 'Result' or h[key.tag] != '*') ? h[key.tag] : '' %}
                                {% endif %}
                                data-{{ key.key }}="{{ v|e('html_attr') }}"
                            {%- endfor %}
                            {% if loop.first %} selected="selected"{% endif %}
                        >{{ label|trim }}</option>
                    {% endfor %}
                </select>
            </div>
        {% endif %}
    {% endblock %}

    {% block viewer %}
        {% if hasGames %}
            {#
                Feldfarben (--lpv-square-light/-dark, siehe public/lpv.css),
                Chrome-Farben des lichess-Viewers (--c-lpv-*, siehe
                public/lichess-pgn-viewer/lichess-pgn-viewer.css) und die
                feste Brettbreite (--lpv-board-width, siehe public/lpv.css)
                werden - falls im Content-Element gesetzt - hier zu einem
                einzigen style="..."-Attribut auf dem inneren
                #{{ elementId }}-Div zusammengeführt (nicht mit dem äußeren,
                Contao-eigenen cssID-"style" auf .lpv-wrapper verwechseln).

                Die feste Brettbreite wirkt nur, wenn die Zugliste rechts
                vom Brett angezeigt wird (options.showMoves == 'right') -
                nur dort konkurrieren Brett und Zugliste in derselben
                CSS-Grid-Zeile um die Breite. --lpv-side-width schaltet die
                Zugliste-Spalte dabei zusätzlich von "fit-content(40%)" auf
                "1fr" um (siehe public/lpv.css), damit die Zugliste den nach
                Abzug des Bretts verbleibenden Platz bis zur über "width"
                konfigurierten Gesamtbreite komplett ausfüllt, statt auf
                ihre Inhaltsbreite begrenzt zu bleiben.
            #}
            {% set widthStyle = width ? 'max-width: ' ~ width ~ ';' : '' %}
            {% set boardWidthActive = boardWidth and options.showMoves == 'right' %}
            {% set boardWidthStyle = boardWidthActive ? ('--lpv-board-width: ' ~ boardWidth ~ '; --lpv-side-width: 1fr;') : '' %}
            {% set styleAttr = (
                widthStyle
                ~ (widthStyle and (designStyle or boardWidthStyle) ? ' ' : '')
                ~ designStyle
                ~ (designStyle and boardWidthStyle ? ' ' : '')
                ~ boardWidthStyle
            )|trim %}
            <div
                id="{{ elementId }}"
                class="lpv-root{% if cssClass %} {{ cssClass }}{% endif %}"
                data-lpv-root
                data-lpv-options="{{ elementId }}-options"
                {%- if not showGameSelect %}
                    {% set h = games[0].headers %}
                    data-lpv-pgn="{{ games[0].pgn|e('html_attr') }}"
                    {%- for key in lpvInfoFields %}
                        {% if key.tag == 'Date' %}
                            {#
                                Datum im Systemformat statt PGN-Rohformat -
                                dieselbe Logik wie im gameInfo-Block oben,
                                siehe dort für Details.
                            #}
                            {% set dp = h.Date is defined and h.Date ? h.Date|split('.')|map(p => p matches '/^[0-9]+$/' ? p : '') : ['', '', ''] %}
                            {% set v = dp[0] and dp[1] and dp[2] ? '%02d.%02d.%04d'|format(dp[2], dp[1], dp[0]) : (dp[0] and dp[1] ? '%02d.%04d'|format(dp[1], dp[0]) : dp[0]) %}
                        {% else %}
                            {% set v = h[key.tag] is defined and h[key.tag] and h[key.tag] != '?' and (key.tag != 'Result' or h[key.tag] != '*') ? h[key.tag] : '' %}
                        {% endif %}
                        data-{{ key.key }}="{{ v|e('html_attr') }}"
                    {%- endfor %}
                {% endif -%}
                {%- if styleAttr %} style="{{ styleAttr }}"{% endif -%}
            ></div>
            <script type="application/json" id="{{ elementId }}-options">{{ optionsJson|raw }}</script>
            <link rel="stylesheet" href="{{ assetsPath }}/lichess-pgn-viewer.css?v={{ assetsVersion }}">
            <script type="module" src="{{ assetsPath }}/lichess-pgn-viewer-init.js?v={{ assetsVersion }}"></script>
        {% else %}
            <p class="lpv-empty">{{ 'MSC.lpv_noGames'|trans({}, 'contao_default') }}</p>
        {% endif %}
    {% endblock %}

    {% block remark %}
        {#
            Freitext-Anmerkung zur Partie (Feld "remark" aus
            wiksoft/dbchess-bundle, tl_dbChess_games) - nur bei den
            dbChess-Quellen ("d"/"e") befüllt, siehe
            ContentLichessPgnviewer::buildGamesFromDbRow(). Bezieht sich
            bewusst nur auf die erste/initial geladene Partie: bei mehreren
            Partien in der Auswahlliste (Block "gameSelect") wechselt dieser
            Block beim Umschalten NICHT automatisch mit.
        #}
        {% if remark %}
            <div class="lpv-remark rte content-text">
                {{ remark|sanitize_html('contao')|csp_inline_styles|encode_email|insert_tag_raw }}
            </div>
        {% endif %}
    {% endblock %}
</div>
<!-- indexer::continue -->
