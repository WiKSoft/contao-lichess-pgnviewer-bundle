<!-- indexer::stop -->
{#
    Zusätzliche Partiedaten, die der lichess-pgn-viewer selbst nicht
    anzeigt (er zeigt nur Spielernamen/Elo im eigenen Kopfbereich). "tag"
    ist der PGN-Tag-Name (siehe game.headers), "key" der daraus abgeleitete
    data-*-Attribut-/Übersetzungsschlüssel (MSC.lpv_info_<key>).
#}
{% set lpvInfoFields = [
    {'tag': 'White', 'key': 'white'},
    {'tag': 'WhiteElo', 'key': 'whiteelo'},
    {'tag': 'Black', 'key': 'black'},
    {'tag': 'BlackElo', 'key': 'blackelo'},
    {'tag': 'Result', 'key': 'result'},
    {'tag': 'Event', 'key': 'event'},
    {'tag': 'Round', 'key': 'round'},
    {'tag': 'Site', 'key': 'site'},
    {'tag': 'Date', 'key': 'date'},
    {'tag': 'ECO', 'key': 'eco'},     
    {'tag': 'Annotator', 'key': 'annotator'},
    {'tag': 'Source', 'key': 'source'},
] %}
<div class="{{ class }} block lpv-wrapper{% if movesLeft %} lpv-wrapper--moves-left{% endif %}{% if movesFlow %} lpv-wrapper--moves-flow{% endif %}{% if pieceSet|default %} lpv-pieces--{{ pieceSet }}{% endif %}{% block wrapperExtraClass %}{% endblock %}"{{ cssID|raw }}{% if style %} style="{{ style }}"{% endif %}>
    {#
        Figurensatz (Feld "Figurensatz", siehe Board\PieceSets): Die Datei
        überschreibt die Figurenbilder für .lpv-pieces--<satz>. Steht
        außerhalb der Blöcke, damit eigene Vorlagen sie nicht verlieren.
        Beim Standard "cburnett" gibt es keine eigene Datei.
    #}
    {% if pieceSetStylesheet|default %}
        <link rel="stylesheet" href="{{ pieceSetStylesheet }}">
    {% endif %}
    {% block headline %}
        {% if headline %}
            <{{ hl }}>{{ headline }}</{{ hl }}>
        {% endif %}
    {% endblock %}

    {#
        Keine Runden- oder Partie-Navigation im Basis-Template. Bei Quelle
        "Interne Datenbank - Liste" stehen dafür die Variablen currentRound/
        prevRound/nextRound/prevRoundHref/nextRoundHref sowie prevGameHref/
        nextGameHref (samt Spielernamen) bereit, außerdem immer upHref/
        upTitle. Eigene Vorlagen können sie z. B. in einem überschriebenen
        "gameInfo"-Block ausgeben (siehe README, Abschnitt "Eigene Vorlagen").
    #}

    {% block gameInfo %}
        {#
            Weitere Partiedaten (Veranstaltung, Ort, Runde, ECO, Elo,
            Kommentator, Quelle), die der lichess-pgn-viewer selbst nicht
            anzeigt (er zeigt nur Spielernamen/Elo im Kopf). Wird beim
            Wechsel der Partie im Dropdown per JavaScript aus den
            data-*-Attributen der ausgewählten <option> aktualisiert, siehe
            lichess-pgn-viewer-init.js.
        #}
        {% if hasGames and showGameInfo %}
            {% set h = games[0].headers %}
            <dl class="lpv-info" id="{{ elementId }}-info">
                {% for key in lpvInfoFields %}
                    {% if key.tag == 'Date' %}
                        {#
                            Datum im Systemformat (d.m.Y, siehe
                            system/config/localconfig.php) statt PGN-Rohformat
                            (JJJJ.MM.TT); unbekannte Teile ("?"/"??") werden
                            weggelassen, bekannte Teile bleiben zusammen (z. B.
                            "1905.08.??" -> "08.1905", "1905.??.??" -> "1905").
                        #}
                        {% set dp = h.Date is defined and h.Date ? h.Date|split('.')|map(p => p matches '/^[0-9]+$/' ? p : '') : ['', '', ''] %}
                        {% set v = dp[0] and dp[1] and dp[2] ? '%02d.%02d.%04d'|format(dp[2], dp[1], dp[0]) : (dp[0] and dp[1] ? '%02d.%04d'|format(dp[1], dp[0]) : dp[0]) %}
                    {% else %}
                        {% set v = h[key.tag] is defined and h[key.tag] and h[key.tag] != '?' and (key.tag != 'Result' or h[key.tag] != '*') ? h[key.tag] : '' %}
                    {% endif %}
                    <div class="lpv-info__row" data-lpv-info="{{ key.key }}"{% if not v %} hidden{% endif %}>
                        <dt>{{ ('MSC.lpv_info_' ~ key.key)|trans({}, 'contao_default') }}</dt>
                        <dd>{{ v }}</dd>
                    </div>
                {% endfor %}
            </dl>
        {% endif %}
    {% endblock %}

    {% block gameSelect %}
        {#
            Auswahlliste bei mehreren Partien in der PGN-Quelle - hier stets
            mit der Spielpaarung (Weiß - Schwarz, ggf. mit Datum) als
            Beschriftung, weil "games"/"matchingGames" an dieser Stelle in
            der Regel tatsächlich UNTERSCHIEDLICHE Partien enthalten (andere
            Sammlungseinträge bei Quelle "d", andere manuell gewählte
            Partien bei Quelle "e", andere Partien einer Mehr-Partien-Datei/
            eines Mehr-Partien-Texts bei "f"/"t").

            Bei Quelle "Interne Datenbank" (lpv_source == "d") werden ALLE
            zur Sammlung/zum Filter passenden Partien aufgelistet (siehe
            "matchingGames", von
            ContentLichessPgnviewer::buildMatchingGamesList() befüllt -
            bewusst die VOLLE, nicht um sid-Varianten bereinigte Liste, damit
            auch sid-Varianten hier als eigener, einzeln anwählbarer Eintrag
            auftauchen; die Primärpartie steht dabei durch die Sortierung vor
            ihrer Variante). Ein Wechsel navigiert dabei per vollständigem
            Seitenaufruf zur jeweiligen Partie-URL statt clientseitig
            zwischen eingebetteten Partien zu wechseln - nötig, weil eine
            Sammlung sehr viele Partien enthalten kann und diese sonst
            komplett (inkl. PGN-Zugfolge) ins HTML eingebettet werden
            müssten.

            Für die anderen Quellen ("e"/"f"/"t") bleibt es beim bisherigen
            clientseitigen Wechsel zwischen den in "games" enthaltenen
            Partien, siehe Block "gameSelectEmbedded" weiter unten.
        #}
        {% if lpv_source == 'd' %}
            {% if matchingGames|length > 1 %}
                <div class="lpv-select">
                    <label for="{{ elementId }}-select">{{ 'MSC.lpv_gameSelect_label'|trans({}, 'contao_default') }}</label>
                    <select id="{{ elementId }}-select" class="lpv-select__input" onchange="if (this.value) { window.location.href = this.value; }">
                        {% for game in matchingGames %}
                            {% if game.href %}
                                {#
                                    Datum im Systemformat statt PGN-Rohformat
                                    für die Dropdown-Beschriftung - dieselbe
                                    Logik wie im gameInfo-Block oben, siehe
                                    dort für Details.
                                #}
                                {% set dp = game.date ? game.date|split('.')|map(p => p matches '/^[0-9]+$/' ? p : '') : ['', '', ''] %}
                                {% set dv = dp[0] and dp[1] and dp[2] ? '%02d.%02d.%04d'|format(dp[2], dp[1], dp[0]) : (dp[0] and dp[1] ? '%02d.%04d'|format(dp[1], dp[0]) : dp[0]) %}
                                {#
                                    Reihenfolge der Beschriftung bewusst
                                    Paarung, dann Ergebnis, dann Datum, dann
                                    Kommentator in eckigen Klammern (falls
                                    vorhanden) - "*" (PGN-Platzhalter für
                                    "noch offen") wird wie beim Ergebnis-Feld
                                    in "gameInfo" oben nicht angezeigt.
                                #}
                                {% set result = game.result and game.result != '*' ? game.result : '' %}
                                {% set annotator = game.annotator and game.annotator != '?' ? game.annotator : '' %}
                                {% set label = game.white ~ (game.white and game.black ? ' - ' : '') ~ game.black ~ (result ? ' ' ~ result : '') ~ (dv ? ' ' ~ dv : '') ~ (annotator ? ' [' ~ annotator ~ ']' : '') %}
                                <option value="{{ game.href }}"{% if game.isCurrent %} selected="selected"{% endif %}>{{ label|trim }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
        {% else %}
            {#
                "gameSelectEmbedded" ist als verschachtelter Block bewusst
                HIER (im "else"-Zweig) deklariert statt als eigenständiger
                Block auf oberster Ebene: ein Twig-"block"-Tag rendert seinen
                Default-Inhalt immer automatisch an seiner Position im
                Template, sobald die Ausführung dort ankommt - auf oberster
                Ebene stünde er also IMMER zusätzlich zum "if"-Zweig oben im
                HTML (sichtbarer Duplikat-Bug: zwei Dropdowns mit identischer
                ID). Verschachtelt hier wird er nur gerendert, wenn dieser
                "else"-Zweig tatsächlich erreicht wird (Quelle ungleich "d").
                Der Blockname bleibt trotzdem von überall in der
                Vererbungskette per {{ block('gameSelectEmbedded') }}
                aufrufbar.
            #}
            {% block gameSelectEmbedded %}
                {#
                    Clientseitige Auswahlliste (Spielpaarung als
                    Beschriftung) für die Quellen "e"/"f"/"t", bei denen
                    "games" bereits alle Partien vollständig eingebettet
                    enthält (siehe collectGamesFromSelection() bzw.
                    PgnSplitter::split()).

                    "games" enthält alle gefundenen Partien in der
                    Reihenfolge der Quelle (Datei-/Textreihenfolge). Jede
                    Partie hat "pgn" (vollständiger Partie-PGN-Text) sowie
                    "headers" (die geparsten PGN-Tag-Pairs, z. B.
                    headers.White, headers.Black, headers.Date,
                    headers.Event, headers.Round, headers.Result,
                    headers.Eco - je nachdem, welche Tags in der Partie
                    vorhanden sind).

                    Anzeige UND Sortierung der Menüpunkte sind bewusst hier
                    im Template gelöst, nicht im PHP-Code:
                    - Beschriftung anpassen: siehe "label"-Berechnung weiter
                      unten.
                    - Reihenfolge umkehren: "games" z. B. durch
                      "games|reverse" ersetzen.
                    - Nach einem Header-Feld sortieren (falls die
                      Twig-Version Arrow-Functions im sort-Filter
                      unterstützt, ab Twig 3.11):
                      games|sort((a, b) => (a.headers.White ?? '') <=> (b.headers.White ?? ''))
                #}
                {% if showGameSelect %}
                    <div class="lpv-select">
                        <label for="{{ elementId }}-select">{{ 'MSC.lpv_gameSelect_label'|trans({}, 'contao_default') }}</label>
                        <select id="{{ elementId }}-select" class="lpv-select__input" data-lpv-select>
                            {% for game in games %}
                                {% set h = game.headers %}
                                {#
                                    Datum im Systemformat statt PGN-Rohformat
                                    für die Dropdown-Beschriftung - dieselbe
                                    Logik wie im gameInfo-Block oben, siehe
                                    dort für Details.
                                #}
                                {% set dp = h.Date is defined and h.Date ? h.Date|split('.')|map(p => p matches '/^[0-9]+$/' ? p : '') : ['', '', ''] %}
                                {% set dv = dp[0] and dp[1] and dp[2] ? '%02d.%02d.%04d'|format(dp[2], dp[1], dp[0]) : (dp[0] and dp[1] ? '%02d.%04d'|format(dp[1], dp[0]) : dp[0]) %}
                                {#
                                    Reihenfolge der Beschriftung bewusst
                                    Paarung, dann Ergebnis, dann Datum, dann
                                    Kommentator in eckigen Klammern (falls
                                    vorhanden) - "?"/"*" (PGN-Platzhalter für
                                    "unbekannt"/"noch offen") werden wie in
                                    "gameInfo" oben nicht angezeigt.
                                #}
                                {% set white = h.White is defined and h.White and h.White != '?' ? h.White : '' %}
                                {% set black = h.Black is defined and h.Black and h.Black != '?' ? h.Black : '' %}
                                {% set result = h.Result is defined and h.Result and h.Result != '?' and h.Result != '*' ? h.Result : '' %}
                                {% set annotator = h.Annotator is defined and h.Annotator and h.Annotator != '?' ? h.Annotator : '' %}
                                {% set label = white ~ (white and black ? ' - ' : '') ~ black ~ (result ? ' ' ~ result : '') ~ (dv ? ' ' ~ dv : '') ~ (annotator ? ' [' ~ annotator ~ ']' : '') %}
                                <option
                                    value="{{ loop.index0 }}"
                                    data-pgn="{{ game.pgn|e('html_attr') }}"
                                    {%- for key in lpvInfoFields %}
                                        {% if key.tag == 'Date' %}
                                            {% set v = dv %}
                                        {% else %}
                                            {% set v = h[key.tag] is defined and h[key.tag] and h[key.tag] != '?' and (key.tag != 'Result' or h[key.tag] != '*') ? h[key.tag] : '' %}
                                        {% endif %}
                                        data-{{ key.key }}="{{ v|e('html_attr') }}"
                                    {%- endfor %}
                                    {% if loop.first %} selected="selected"{% endif %}
                                >{{ label|trim != '' ? label|trim : ('MSC.lpv_game_fallback'|trans({}, 'contao_default')) }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            {% endblock %}
        {% endif %}
    {% endblock %}

    {% block viewer %}
        {% if hasGames %}
            {#
                Feldfarben (--lpv-square-light/-dark, siehe public/lpv.css),
                Chrome-Farben des lichess-Viewers (--c-lpv-*, siehe
                public/lichess-pgn-viewer/lichess-pgn-viewer.css) und die
                Brettbreite (--lpv-board-width, siehe public/lpv.css)
                werden - falls im Content-Element gesetzt - hier zu einem
                einzigen style="..."-Attribut auf dem inneren
                #{{ elementId }}-Div zusammengeführt (nicht mit dem äußeren,
                Contao-eigenen cssID-"style" auf .lpv-wrapper verwechseln).

                Die Brettbreite wirkt nur, wenn die Zugliste rechts oder
                links vom Brett angezeigt wird (options.showMoves ==
                'right', "links" läuft intern ebenfalls als 'right') -
                nur dort konkurrieren Brett und Zugliste in derselben
                CSS-Grid-Zeile um die Breite. Sie ist eine Höchstbreite:
                fehlt der Platz, wird das Brett schmaler, die Zugliste
                behält mindestens 232px (siehe public/lpv.css).
            #}
            {% set widthStyle = width ? 'max-width: ' ~ width ~ ';' : '' %}
            {% set boardWidthActive = boardWidth and options.showMoves == 'right' %}
            {% set boardWidthStyle = boardWidthActive ? ('--lpv-board-width: ' ~ boardWidth ~ ';') : '' %}
            {% set styleAttr = (
                widthStyle
                ~ (widthStyle and (designStyle or boardWidthStyle) ? ' ' : '')
                ~ designStyle
                ~ (designStyle and boardWidthStyle ? ' ' : '')
                ~ boardWidthStyle
            )|trim %}
            <div
                id="{{ elementId }}"
                class="lpv-root{% if cssClass %} {{ cssClass }}{% endif %}"
                data-lpv-root
                data-lpv-options="{{ elementId }}-options"
                {#
                    "data-lpv-pgn" (Partie games[0], die aktuell angezeigte -
                    siehe collectSidVariants()/buildMatchingGamesList(),
                    beide stellen sie stets voran) wird bewusst UNBEDINGT
                    eingebettet, nicht nur wenn "not showGameSelect": das
                    "Alle Partien"-Dropdown im Basis-Template (Quelle "d",
                    siehe Block "gameSelect") trägt anders als
                    "gameSelectEmbedded" bewusst
                    KEIN "data-lpv-select"-Attribut (Partiewechsel dort läuft
                    ja per Seiten-Link, nicht clientseitig) - ohne dieses
                    Attribut findet lichess-pgn-viewer-init.js dort keinen
                    Select und bräuchte "data-lpv-pgn" als Fallback, auch wenn
                    "showGameSelect" (gezählt über die - hiervon unabhängige -
                    sid-Varianten-Liste "games") zufällig true ist (z. B. weil
                    die angezeigte Partie sid-Varianten hat). Ist dagegen
                    tatsächlich ein "data-lpv-select"-Dropdown vorhanden,
                    bevorzugt das Init-Script dieses ohnehin und ignoriert
                    "data-lpv-pgn" auf dem Root-Element (siehe dort: "if
                    (select) { ... } else if (root.dataset.lpvPgn) { ... }") -
                    die unbedingte Einbettung ist also in jedem Fall sicher.
                #}
                {% set h = games[0].headers %}
                data-lpv-pgn="{{ games[0].pgn|e('html_attr') }}"
                {%- for key in lpvInfoFields %}
                    {% if key.tag == 'Date' %}
                        {#
                            Datum im Systemformat statt PGN-Rohformat -
                            dieselbe Logik wie im gameInfo-Block oben,
                            siehe dort für Details.
                        #}
                        {% set dp = h.Date is defined and h.Date ? h.Date|split('.')|map(p => p matches '/^[0-9]+$/' ? p : '') : ['', '', ''] %}
                        {% set v = dp[0] and dp[1] and dp[2] ? '%02d.%02d.%04d'|format(dp[2], dp[1], dp[0]) : (dp[0] and dp[1] ? '%02d.%04d'|format(dp[1], dp[0]) : dp[0]) %}
                    {% else %}
                        {% set v = h[key.tag] is defined and h[key.tag] and h[key.tag] != '?' and (key.tag != 'Result' or h[key.tag] != '*') ? h[key.tag] : '' %}
                    {% endif %}
                    data-{{ key.key }}="{{ v|e('html_attr') }}"
                {%- endfor %}
                {%- if styleAttr %} style="{{ styleAttr }}"{% endif -%}
            ></div>
            <script type="application/json" id="{{ elementId }}-options">{{ optionsJson|raw }}</script>
            <link rel="stylesheet" href="{{ assetsPath }}/lichess-pgn-viewer.css?v={{ assetsVersion }}">
            <script type="module" src="{{ assetsPath }}/lichess-pgn-viewer-init.js?v={{ assetsVersion }}"></script>
        {% else %}
            <p class="lpv-empty">{{ 'MSC.lpv_noGames'|trans({}, 'contao_default') }}</p>
        {% endif %}
    {% endblock %}

    {% block remark %}
        {#
            Freitext-Anmerkung zur Partie (Feld "remark" aus
            wiksoft/contao-dbchess-bundle, tl_dbChess_games) - nur bei den
            dbChess-Quellen ("d"/"e") befüllt, siehe
            ContentLichessPgnviewer::buildGamesFromDbRow(). Bezieht sich
            bewusst nur auf die erste/initial geladene Partie: bei mehreren
            Partien in der Auswahlliste (Block "gameSelect") wechselt dieser
            Block beim Umschalten NICHT automatisch mit.
        #}
        {% if remark %}
            <div class="lpv-remark rte content-text">
                {{ remark|sanitize_html('contao')|csp_inline_styles|encode_email|insert_tag_raw }}
            </div>
        {% endif %}
    {% endblock %}
</div>
<!-- indexer::continue -->
