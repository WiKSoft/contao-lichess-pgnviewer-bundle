{
    "name": "wiksoft/contao-lichess-pgnviewer-bundle",
    "type": "contao-bundle",
    "description": "Schachpartien (PGN) im Contao-Frontend nachspielbar machen, mit dem lichess.org PGN-Viewer.",
    "keywords": [
        "contao",
        "chess",
        "schach",
        "pgn",
        "pgn-viewer",
        "lichess",
        "chessboard",
        "schachbrett"
    ],
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/WiKSoft/contao-lichess-pgnviewer-bundle",
    "authors": [
        {
            "name": "Wilfried Krebbers",
            "homepage": "https://github.com/WiKSoft",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/WiKSoft/contao-lichess-pgnviewer-bundle/issues",
        "source": "https://github.com/WiKSoft/contao-lichess-pgnviewer-bundle"
    },
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.3"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "suggest": {
        "wiksoft/contao-dbchess-bundle": "Erlaubt es, Partien aus der dbChess-Datenbank als PGN-Quelle auszuwählen."
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Wiksoft\\ContaoLichessPgnviewerBundle\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Wiksoft\\ContaoLichessPgnviewerBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true
        }
    }
}
